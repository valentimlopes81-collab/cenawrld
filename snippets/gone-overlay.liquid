{%- doc -%}
  Light shade with "GONE" over the photo of a sold-out product (the card still links to the product page).
  The parent must be position: relative.

  @param {product} product - The product

  @example
  {% render 'gone-overlay', product: product %}
{%- enddoc -%}

{%- if product != blank and product.available == false -%}
  <span class="gone-overlay" aria-hidden="true"><span class="gone-overlay__word">GONE</span></span>
  <span class="visually-hidden">{{ 'content.product_badge_sold_out' | t }}</span>
{%- endif -%}

{% stylesheet %}
  .gone-overlay {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgb(255 255 255 / 0.55);
    pointer-events: none;
    container-type: inline-size;
  }

  .gone-overlay__word {
    font-family: var(--font-heading--family);
    font-weight: 800;
    font-size: clamp(22px, 14cqi, 64px);
    letter-spacing: 0.04em;
    line-height: 1;
    color: #000;
    text-transform: uppercase;
  }
{% endstylesheet %}
