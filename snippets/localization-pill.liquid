{%- doc -%}
  Renders a compact country/currency pill (flag + currency code + caret)
  that opens a minimalist custom dropdown listing every available country
  with its flag, name and currency, plus a search field to filter it.

  @param {string} id - A unique suffix so multiple instances (desktop/mobile) don't collide.
  @param {boolean} compact - Shows only the flag + currency symbol on the trigger (no code, no caret), to save space. The dropdown itself is unaffected.
{%- enddoc -%}

{%- assign localization_form_id = 'localization-form-' | append: id -%}
{%- assign currency_symbol = localization.country.currency.iso_code -%}
{%- case localization.country.currency.iso_code -%}
  {%- when 'EUR' -%}{%- assign currency_symbol = '€' -%}
  {%- when 'USD' -%}{%- assign currency_symbol = '$' -%}
  {%- when 'GBP' -%}{%- assign currency_symbol = '£' -%}
  {%- when 'CAD' -%}{%- assign currency_symbol = 'CA$' -%}
  {%- when 'MXN' -%}{%- assign currency_symbol = 'MX$' -%}
  {%- when 'BRL' -%}{%- assign currency_symbol = 'R$' -%}
  {%- when 'ARS' -%}{%- assign currency_symbol = 'AR$' -%}
  {%- when 'CLP' -%}{%- assign currency_symbol = 'CL$' -%}
  {%- when 'COP' -%}{%- assign currency_symbol = 'COL$' -%}
  {%- when 'CNY' -%}{%- assign currency_symbol = '¥' -%}
  {%- when 'JPY' -%}{%- assign currency_symbol = '¥' -%}
{%- endcase -%}

<div class="header__icon localization-icon" data-localization-instance="{{ id }}">
  {% form 'localization', id: localization_form_id %}
    <button type="button" class="localization-toggle{% if compact %} localization-toggle--compact{% endif %}" aria-label="Country and currency" aria-expanded="false">
      <span
        class="localization-flag"
        style="background-image: url({{ localization.country | image_url: width: 32 }});"
      ></span>
      {% if compact %}
        <span class="localization-currency-symbol">{{ currency_symbol }}</span>
      {% else %}
        <span class="localization-currency">{{ localization.country.currency.iso_code }}</span>
        <span class="localization-caret">{{ 'icon-caret.svg' | inline_asset_content }}</span>
      {% endif %}
    </button>

    {% if localization.available_countries.size > 1 %}
      <div class="localization-dropdown" data-instance="{{ id }}">
        <div class="localization-search">
          <input
            type="text"
            class="localization-search-input"
            placeholder="Search country"
            autocomplete="off"
            data-localization-search
          >
        </div>

        <ul class="localization-list" data-localization-list>
          {% for country in localization.available_countries %}
            <li
              class="localization-list__item{% if country.iso_code == localization.country.iso_code %} is-active{% endif %}"
              data-country-name="{{ country.name | downcase }}"
            >
              <button type="submit" form="{{ localization_form_id }}" name="country_code" value="{{ country.iso_code }}" class="localization-list__button">
                <span
                  class="localization-list__flag"
                  style="background-image: url({{ country | image_url: width: 32 }});"
                ></span>
                <span class="localization-list__name">{{ country.name }}</span>
                <span class="localization-list__currency">{{ country.currency.iso_code }}</span>
              </button>
            </li>
          {% endfor %}
        </ul>

        <p class="localization-empty" data-localization-empty hidden>No matches</p>
      </div>
    {% endif %}
  {% endform %}
</div>
