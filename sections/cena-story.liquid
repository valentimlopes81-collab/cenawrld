{%- comment -%}
  "WHAT IS CENA?" page: customizable photo + text layout.
  Add Photo, Heading and Text blocks in the theme editor; every block has its own width, shape and alignment.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign wrap_class = 'cena-story__inner'
  if s.layout == 'page'
    assign wrap_class = 'cena-story__inner cena-story__inner--page'
  endif
-%}

<section
  class="cena-story cena-story-{{ section.id }}"
  style="
    --cs-bg: {{ s.background_color }};
    --cs-fg: {{ s.text_color }};
    --cs-gap: {{ s.gap }}px;
    --cs-gap-mobile: {{ s.gap_mobile }}px;
    --cs-pt: {{ s.padding_top }}px;
    --cs-pb: {{ s.padding_bottom }}px;
  "
>
  <div class="{{ wrap_class }}">
    {%- for block in section.blocks -%}
      {%- assign b = block.settings -%}
      {%- case block.type -%}
        {%- when 'photo' -%}
          <figure
            class="cena-story__item cena-story__photo cena-story__w-{{ b.width }}{% if b.keep_side_by_side_on_mobile %} cena-story__keep{% endif %}"
            style="--cs-ratio: {{ b.shape }}; --cs-fit: {{ b.fit }}; --cs-radius: {{ b.corner_radius }}px; --cs-align: {{ b.caption_alignment }};"
            {{ block.shopify_attributes }}
          >
            {%- capture photo_html -%}
              <span class="cena-story__frame{% if b.shape == 'auto' %} cena-story__frame--auto{% endif %}">
                {%- if b.image != blank -%}
                  {{ b.image | image_url: width: 2000 | image_tag: loading: 'lazy', widths: '400, 700, 1000, 1400, 2000', sizes: '(min-width: 750px) 100vw, 100vw', alt: b.image.alt | default: b.caption }}
                {%- else -%}
                  {{ 'lifestyle-1' | placeholder_svg_tag: 'cena-story__placeholder' }}
                {%- endif -%}
              </span>
            {%- endcapture -%}
            {%- if b.link != blank -%}<a href="{{ b.link }}" class="cena-story__link">{{ photo_html }}</a>{%- else -%}{{ photo_html }}{%- endif -%}
            {%- if b.caption != blank -%}<figcaption class="cena-story__caption">{{ b.caption }}</figcaption>{%- endif -%}
          </figure>

        {%- when 'heading' -%}
          <div
            class="cena-story__item cena-story__w-{{ b.width }}"
            style="--cs-align: {{ b.alignment }}; --cs-size: {{ b.size }}px; --cs-size-mobile: {{ b.size_mobile }}px;"
            {{ block.shopify_attributes }}
          >
            <h2 class="cena-story__heading{% if b.uppercase %} cena-story__heading--caps{% endif %}">{{ b.text }}</h2>
          </div>

        {%- when 'text' -%}
          <div
            class="cena-story__item cena-story__w-{{ b.width }}"
            style="--cs-align: {{ b.alignment }}; --cs-size: {{ b.size }}px; --cs-size-mobile: {{ b.size_mobile }}px; --cs-maxw: {{ b.max_width }}px;"
            {{ block.shopify_attributes }}
          >
            <div class="cena-story__text">{{ b.text }}</div>
          </div>

        {%- when 'spacer' -%}
          <div class="cena-story__item cena-story__w-full cena-story__spacer" style="--cs-space: {{ b.height }}px;" {{ block.shopify_attributes }}></div>
      {%- endcase -%}
    {%- endfor -%}
  </div>
</section>

{% stylesheet %}
  .cena-story { background: var(--cs-bg); color: var(--cs-fg); padding: var(--cs-pt) 0 var(--cs-pb); }
  .cena-story__inner {
    display: flex; flex-wrap: wrap; align-items: flex-start; gap: var(--cs-gap-mobile);
    margin: 0 auto;
  }
  .cena-story__inner--page { max-width: 1200px; padding-inline: 20px; box-sizing: border-box; }
  .cena-story__item { margin: 0; box-sizing: border-box; flex: 0 0 100%; min-width: 0; }
  @media (min-width: 750px) {
    .cena-story__inner { gap: var(--cs-gap); }
    .cena-story__w-full { flex-basis: 100%; }
    .cena-story__w-two-thirds { flex-basis: calc(66.666% - var(--cs-gap) / 3); }
    .cena-story__w-half { flex-basis: calc(50% - var(--cs-gap) / 2); }
    .cena-story__w-third { flex-basis: calc(33.333% - var(--cs-gap) * 2 / 3); }
    .cena-story__w-quarter { flex-basis: calc(25% - var(--cs-gap) * 3 / 4); }
  }
  @media (max-width: 749px) {
    .cena-story__keep { flex-basis: calc(50% - var(--cs-gap-mobile) / 2); }
  }

  .cena-story__frame { display: block; overflow: hidden; border-radius: var(--cs-radius, 0); }
  .cena-story__frame:not(.cena-story__frame--auto) { aspect-ratio: var(--cs-ratio); }
  .cena-story__frame img, .cena-story__frame svg { display: block; width: 100%; }
  .cena-story__frame:not(.cena-story__frame--auto) img,
  .cena-story__frame:not(.cena-story__frame--auto) svg { height: 100%; object-fit: var(--cs-fit, cover); }
  .cena-story__frame svg { background: #eee; }
  .cena-story__link { display: block; color: inherit; }
  .cena-story__caption { margin-top: 10px; font-size: 13px; text-align: var(--cs-align, left); letter-spacing: .2px; }

  .cena-story__heading {
    margin: 0; text-align: var(--cs-align, left); font-size: var(--cs-size-mobile); line-height: 1.1; font-weight: 700;
  }
  .cena-story__heading--caps { text-transform: uppercase; }
  .cena-story__text {
    text-align: var(--cs-align, left); font-size: var(--cs-size-mobile); line-height: 1.6;
    max-width: var(--cs-maxw, 700px);
    margin-inline: auto;
  }
  .cena-story__text p { margin: 0 0 1em; }
  @media (min-width: 750px) {
    .cena-story__heading { font-size: var(--cs-size); }
    .cena-story__text { font-size: var(--cs-size); }
  }
  .cena-story__spacer { height: var(--cs-space); }
{% endstylesheet %}

{% schema %}
{
  "name": "WHAT IS CENA? story",
  "settings": [
    { "type": "header", "content": "Layout" },
    {
      "type": "select",
      "id": "layout",
      "label": "Width",
      "options": [
        { "value": "page", "label": "Page width" },
        { "value": "full", "label": "Full screen" }
      ],
      "default": "page"
    },
    { "type": "range", "id": "gap", "label": "Space between blocks (desktop)", "min": 0, "max": 80, "step": 2, "unit": "px", "default": 16 },
    { "type": "range", "id": "gap_mobile", "label": "Space between blocks (mobile)", "min": 0, "max": 60, "step": 2, "unit": "px", "default": 12 },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 24 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 24 },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#ffffff" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#000000" }
  ],
  "blocks": [
    {
      "type": "photo",
      "name": "Photo",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Photo" },
        {
          "type": "select",
          "id": "width",
          "label": "Width (desktop)",
          "options": [
            { "value": "full", "label": "Full row" },
            { "value": "two-thirds", "label": "2/3" },
            { "value": "half", "label": "1/2" },
            { "value": "third", "label": "1/3" },
            { "value": "quarter", "label": "1/4" }
          ],
          "default": "full"
        },
        { "type": "checkbox", "id": "keep_side_by_side_on_mobile", "label": "Two per row on mobile (when width is 1/2 or smaller)", "default": false },
        {
          "type": "select",
          "id": "shape",
          "label": "Shape",
          "options": [
            { "value": "auto", "label": "Original (no crop)" },
            { "value": "4 / 5", "label": "Portrait 4:5" },
            { "value": "2 / 3", "label": "Tall 2:3" },
            { "value": "1 / 1", "label": "Square" },
            { "value": "3 / 2", "label": "Landscape 3:2" },
            { "value": "16 / 9", "label": "Wide 16:9" }
          ],
          "default": "auto"
        },
        {
          "type": "select",
          "id": "fit",
          "label": "Fit inside the shape",
          "info": "Cover fills the shape and may crop. Contain shows the whole photo.",
          "options": [
            { "value": "cover", "label": "Cover" },
            { "value": "contain", "label": "Contain" }
          ],
          "default": "cover"
        },
        { "type": "range", "id": "corner_radius", "label": "Rounded corners", "min": 0, "max": 40, "step": 2, "unit": "px", "default": 0 },
        { "type": "text", "id": "caption", "label": "Caption" },
        {
          "type": "select",
          "id": "caption_alignment",
          "label": "Caption alignment",
          "options": [
            { "value": "left", "label": "Left" },
            { "value": "center", "label": "Center" },
            { "value": "right", "label": "Right" }
          ],
          "default": "left"
        },
        { "type": "url", "id": "link", "label": "Link (optional)" }
      ]
    },
    {
      "type": "heading",
      "name": "Heading",
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "WHAT IS CENA?" },
        {
          "type": "select",
          "id": "width",
          "label": "Width (desktop)",
          "options": [
            { "value": "full", "label": "Full row" },
            { "value": "two-thirds", "label": "2/3" },
            { "value": "half", "label": "1/2" },
            { "value": "third", "label": "1/3" }
          ],
          "default": "full"
        },
        {
          "type": "select",
          "id": "alignment",
          "label": "Alignment",
          "options": [
            { "value": "left", "label": "Left" },
            { "value": "center", "label": "Center" },
            { "value": "right", "label": "Right" }
          ],
          "default": "center"
        },
        { "type": "range", "id": "size", "label": "Size (desktop)", "min": 16, "max": 120, "step": 2, "unit": "px", "default": 48 },
        { "type": "range", "id": "size_mobile", "label": "Size (mobile)", "min": 14, "max": 80, "step": 2, "unit": "px", "default": 28 },
        { "type": "checkbox", "id": "uppercase", "label": "Capital letters", "default": true }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "settings": [
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Write your story here.</p>" },
        {
          "type": "select",
          "id": "width",
          "label": "Width (desktop)",
          "options": [
            { "value": "full", "label": "Full row" },
            { "value": "two-thirds", "label": "2/3" },
            { "value": "half", "label": "1/2" },
            { "value": "third", "label": "1/3" }
          ],
          "default": "full"
        },
        {
          "type": "select",
          "id": "alignment",
          "label": "Alignment",
          "options": [
            { "value": "left", "label": "Left" },
            { "value": "center", "label": "Center" },
            { "value": "right", "label": "Right" }
          ],
          "default": "left"
        },
        { "type": "range", "id": "size", "label": "Size (desktop)", "min": 12, "max": 40, "step": 1, "unit": "px", "default": 18 },
        { "type": "range", "id": "size_mobile", "label": "Size (mobile)", "min": 12, "max": 32, "step": 1, "unit": "px", "default": 16 },
        { "type": "range", "id": "max_width", "label": "Maximum text width", "min": 300, "max": 1200, "step": 20, "unit": "px", "default": 700 }
      ]
    },
    {
      "type": "spacer",
      "name": "Space",
      "settings": [
        { "type": "range", "id": "height", "label": "Height", "min": 8, "max": 200, "step": 4, "unit": "px", "default": 40 }
      ]
    }
  ],
  "presets": [
    {
      "name": "WHAT IS CENA? story",
      "blocks": [{ "type": "photo" }, { "type": "text" }]
    }
  ]
}
{% endschema %}
