{%- comment -%}
  Row of ALL products, cheapest first, scrolling sideways. Sits right under the homepage banner
  so visitors get to a product with fewer clicks.
{%- endcomment -%}
{%- assign sorted = collections.all.products | sort: 'price' -%}
{%- if section.settings.reverse -%}{%- assign sorted = sorted | reverse -%}{%- endif -%}

<section class="price-scroll" aria-label="Products by price">
  <button type="button" class="price-scroll__arrow price-scroll__arrow--prev" aria-label="Previous products" data-price-scroll-prev>&#8592;</button>
  <ul class="price-scroll__track" data-price-scroll-track>
    {%- for product in sorted -%}
      <li class="price-scroll__item">
        <a class="price-scroll__link" href="{{ product.url }}">
          <span class="price-scroll__media">
            {%- if product.featured_image -%}
              {{ product.featured_image | image_url: width: 640 | image_tag: loading: 'lazy', widths: '320, 480, 640', sizes: '(min-width: 750px) 280px, 70vw', alt: product.title }}
            {%- endif -%}
            {%- unless product.available -%}<span class="price-scroll__soldout">Sold out</span>{%- endunless -%}
          </span>
          <span class="price-scroll__title">{{ product.title }}</span>
          <span class="price-scroll__price">{{ product.price | money }}</span>
        </a>
      </li>
    {%- endfor -%}
  </ul>
  <button type="button" class="price-scroll__arrow price-scroll__arrow--next" aria-label="Next products" data-price-scroll-next>&#8594;</button>
</section>

{% stylesheet %}
  .price-scroll { position: relative; background: #fff; color: #000; padding: 32px 0 40px; }
  .price-scroll__track {
    display: flex; gap: 16px; margin: 0; padding: 0 var(--page-margin, 16px);
    list-style: none; overflow-x: auto; scroll-snap-type: x proximity;
    scrollbar-width: none; -webkit-overflow-scrolling: touch;
  }
  .price-scroll__track::-webkit-scrollbar { display: none; }
  .price-scroll__item { flex: 0 0 70vw; max-width: 320px; scroll-snap-align: start; }
  @media (min-width: 750px) { .price-scroll__item { flex-basis: 280px; } }
  .price-scroll__link { display: block; color: inherit; text-decoration: none; }
  .price-scroll__media { position: relative; display: block; aspect-ratio: 4 / 5; background: #f4f4f4; overflow: hidden; }
  .price-scroll__media img { width: 100%; height: 100%; object-fit: contain; display: block; }
  .price-scroll__soldout {
    position: absolute; top: 8px; left: 8px; padding: 3px 8px; font-size: 11px; font-weight: 700;
    letter-spacing: .4px; text-transform: uppercase; background: #000; color: #fff;
  }
  .price-scroll__title { display: block; margin-top: 10px; font-size: 13px; text-transform: uppercase; letter-spacing: .3px; }
  .price-scroll__price { display: block; margin-top: 2px; font-size: 13px; font-weight: 700; }
  .price-scroll__arrow {
    position: absolute; top: calc(50% - 20px); z-index: 2; width: 40px; height: 40px; border: 0;
    border-radius: 50%; background: #000; color: #fff; font-size: 18px; cursor: pointer;
    display: none; align-items: center; justify-content: center;
  }
  .price-scroll__arrow--prev { left: 12px; }
  .price-scroll__arrow--next { right: 12px; }
  @media (hover: hover) and (min-width: 750px) { .price-scroll__arrow { display: flex; } }
  .price-scroll__arrow[disabled] { opacity: .25; cursor: default; }
{% endstylesheet %}

<script>
  (() => {
    document.querySelectorAll('.price-scroll').forEach((sec) => {
      if (sec.dataset.ready) return;
      sec.dataset.ready = '1';
      const track = sec.querySelector('[data-price-scroll-track]');
      const prev = sec.querySelector('[data-price-scroll-prev]');
      const next = sec.querySelector('[data-price-scroll-next]');
      const step = () => Math.max(track.clientWidth * 0.8, 240);
      const update = () => {
        prev.disabled = track.scrollLeft <= 4;
        next.disabled = track.scrollLeft + track.clientWidth >= track.scrollWidth - 4;
      };
      prev.addEventListener('click', () => track.scrollBy({ left: -step(), behavior: 'smooth' }));
      next.addEventListener('click', () => track.scrollBy({ left: step(), behavior: 'smooth' }));
      track.addEventListener('scroll', update, { passive: true });
      window.addEventListener('resize', update);
      update();
    });
  })();
</script>

{% schema %}
{
  "name": "Products by price",
  "settings": [
    {
      "type": "checkbox",
      "id": "reverse",
      "label": "Most expensive first",
      "default": false
    }
  ],
  "presets": [{ "name": "Products by price" }]
}
{% endschema %}
