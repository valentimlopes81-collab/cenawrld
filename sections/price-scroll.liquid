{%- comment -%}
  Homepage product grid, same look as the Shop all page, right under the banner.
  All products, most expensive first by default.
{%- endcomment -%}
{%- assign sorted = collections.all.products | sort: 'price' -%}
{%- if section.settings.most_expensive_first -%}{%- assign sorted = sorted | reverse -%}{%- endif -%}

<section class="home-grid" aria-label="Products">
  <ul class="home-grid__list">
    {%- for product in sorted -%}
      <li class="home-grid__item">
        <a class="home-grid__link" href="{{ product.url }}">
          <span class="home-grid__media">
            {%- if product.featured_image -%}
              {{ product.featured_image | image_url: width: 800 | image_tag: loading: 'lazy', widths: '320, 480, 640, 800', sizes: '(min-width: 750px) 20vw, 50vw', alt: product.title }}
            {%- endif -%}
            {%- unless product.available -%}<span class="home-grid__soldout">Sold out</span>{%- endunless -%}
          </span>
          <span class="home-grid__title">{{ product.title }}</span>
          <span class="home-grid__price">{{ product.price | money_with_currency }}</span>
        </a>
      </li>
    {%- endfor -%}
  </ul>
</section>

{% stylesheet %}
  .home-grid { background: #fff; color: #000; padding: 24px 0 40px; }
  .home-grid__list {
    display: grid; grid-template-columns: repeat(2, 1fr); gap: 16px 0;
    margin: 0; padding: 0; list-style: none;
  }
  @media (min-width: 750px) {
    .home-grid__list { grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); }
  }
  .home-grid__link { display: block; color: inherit; text-decoration: none; }
  .home-grid__media {
    position: relative; display: block; aspect-ratio: 4 / 5; overflow: hidden; background: #fff;
  }
  .home-grid__media img {
    width: 100%; height: 100%; object-fit: contain; display: block;
    padding: 12% 10%; box-sizing: border-box; transition: transform .4s ease;
  }
  @media (hover: hover) { .home-grid__link:hover .home-grid__media img { transform: scale(1.04); } }
  .home-grid__soldout {
    position: absolute; top: 8px; left: 8px; padding: 3px 8px; font-size: 11px; font-weight: 700;
    letter-spacing: .4px; text-transform: uppercase; background: #000; color: #fff;
  }
  .home-grid__title {
    display: block; margin-top: 10px; padding-inline: 24px; font-size: 14px; letter-spacing: .2px;
    text-transform: uppercase; color: #3a3a3a;
  }
  .home-grid__price { display: block; margin-top: 4px; padding-inline: 24px; font-size: 14px; color: #3a3a3a; }
  @media (max-width: 749px) {
    .home-grid__title, .home-grid__price { padding-inline: 4px; font-size: 12px; }
    /* mobile: horizontal swipe carousel */
    .home-grid__list {
      display: flex; gap: 12px; overflow-x: auto; padding: 0 16px;
      scroll-snap-type: x mandatory; scroll-padding-inline: 16px;
      -webkit-overflow-scrolling: touch; scrollbar-width: none;
    }
    .home-grid__list::-webkit-scrollbar { display: none; }
    .home-grid__item { flex: 0 0 62%; scroll-snap-align: start; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Products grid",
  "settings": [
    {
      "type": "checkbox",
      "id": "most_expensive_first",
      "label": "Most expensive first",
      "default": true
    }
  ],
  "presets": [{ "name": "Products grid" }]
}
{% endschema %}
