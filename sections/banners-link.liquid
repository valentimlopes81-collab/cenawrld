<div class="banner-container"
     style="background-image: url({{ section.settings.banner_image | image_url: width: 2000 }});"
     data-desktop="{{ section.settings.banner_image | image_url: width: 2000 }}"
     data-mobile="{{ section.settings.banner_image_mobile | image_url: width: 1000 }}">
  
  <!-- Links -->
  <div class="banner-links">
    <a href="/collections/homem" class="link-homem">MEN</a>
    <a href="/collections/mulher" class="link-mulher">WOMEN</a>
  </div>
</div>

<style>
.banner-container {
  position: relative;
  width: 100%;
  min-height: 500px; /* desktop height */
  background-position: center;
  background-size: cover;
  background-repeat: no-repeat;
}

/* Desktop: the photo fills the whole first screen (the header floats on top of it) */
@media (min-width: 769px) {
  .banner-container {
    min-height: 100vh;
    min-height: 100svh;
    /* Desktop photo (mobile keeps the photo chosen in the theme editor) */
    background-image: url('{{ 'banner-desktop.jpg' | asset_url }}') !important;
  }
}

/* Links pinned to the bottom */
.banner-links {
  position: absolute;
  bottom: 30px; /* distance from the bottom of the image */
  left: 0;
  right: 0;
  display: flex;
  justify-content: space-between;
  padding: 0 40px;
}

.banner-links a {
  font-weight: bold;
  font-size: 18px;
  color: white; /* change if the image is light */
  text-decoration: none;
  border-bottom: 2px solid white;
  transition: 0.3s;
}

.banner-links a:hover {
  opacity: 0.7;
}

/* Mobile adjustments */
@media (max-width: 768px) {
  .banner-container {
    /* same photo as desktop, cropped to the portrait frame and centred on the face */
    background-image: url('{{ 'banner-desktop.jpg' | asset_url }}') !important;
    /* photo a bit smaller and anchored to the bottom, so the top of the head clears the floating header; shifted right */
    background-size: auto 88% !important;
    background-position: 18% 100% !important;
    background-color: #000;
    min-height: auto; /* let the image control the height */
    aspect-ratio: 9/16; /* keeps a vertical stories-like ratio */
    background-color: black;
    background-image: url('{{ section.settings.banner_image_mobile | image_url: width: 1000 }}');
  }

  .banner-links {
    bottom: 20px;
    padding: 0 20px;
  }

  .banner-links a {
    font-size: 16px;
  }
}
  .banner-links {
    bottom: 20px; /* moves up slightly on mobile */
    padding: 0 20px;
  }

  .banner-links a {
    font-size: 16px;
  }
}
</style>

{% schema %}
{
  "name": "Banner with Links",
  "settings": [
    {
      "type": "image_picker",
      "id": "banner_image",
      "label": "Banner Image (Desktop)"
    },
    {
      "type": "image_picker",
      "id": "banner_image_mobile",
      "label": "Banner Image (Mobile)"
    }
  ],
  "presets": [
    {
      "name": "Banner with Links"
    }
  ]
}
{% endschema %}