<div class="banner-container"
     style="background-image: url({{ section.settings.banner_image | image_url: width: 2000 }});"
     data-desktop="{{ section.settings.banner_image | image_url: width: 2000 }}"
     data-mobile="{{ section.settings.banner_image_mobile | image_url: width: 1000 }}">
  
  <!-- Links -->
  <div class="banner-links">
    <a href="/collections/homem" class="link-homem">HOMEM</a>
    <a href="/collections/mulher" class="link-mulher">MULHER</a>
  </div>
</div>

<style>
.banner-container {
  position: relative;
  width: 100%;
  min-height: 500px; /* altura no desktop */
  background-position: center;
  background-size: cover;
  background-repeat: no-repeat;
}

/* Links fixados em baixo */
.banner-links {
  position: absolute;
  bottom: 30px; /* distância da base da imagem */
  left: 0;
  right: 0;
  display: flex;
  justify-content: space-between;
  padding: 0 40px;
}

.banner-links a {
  font-weight: bold;
  font-size: 18px;
  color: white; /* muda se a imagem for clara */
  text-decoration: none;
  border-bottom: 2px solid white;
  transition: 0.3s;
}

.banner-links a:hover {
  opacity: 0.7;
}

/* Ajustes Mobile */
@media (max-width: 768px) {
  .banner-container {
    min-height: auto; /* deixa a imagem controlar a altura */
    aspect-ratio: 9/16; /* mantém proporção vertical tipo stories */
    background-size: cover; /* enche o espaço sem barras pretas */
    background-position: center;
    background-color: black;
    background-image: url('{{ section.settings.banner_image_mobile | image_url: width: 1000 }}');
  }

  .banner-links {
    bottom: 20px;
    padding: 0 20px;
  }

  .banner-links a {
    font-size: 16px;
  }
}
  .banner-links {
    bottom: 20px; /* sobe um pouco no mobile */
    padding: 0 20px;
  }

  .banner-links a {
    font-size: 16px;
  }
}
</style>

{% schema %}
{
  "name": "Banner com Links",
  "settings": [
    {
      "type": "image_picker",
      "id": "banner_image",
      "label": "Imagem do Banner (Desktop)"
    },
    {
      "type": "image_picker",
      "id": "banner_image_mobile",
      "label": "Imagem do Banner (Mobile)"
    }
  ],
  "presets": [
    {
      "name": "Banner com Links"
    }
  ]
}
{% endschema %}