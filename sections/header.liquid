<header class="scuffers-header">

  <!-- Header Desktop -->
  <div class="header-wrapper">
    
    <!-- Left menu (Shop All / Men / Women) -->
    <nav class="menu-left">
      <ul>
        <li><a href="{{ routes.all_products_collection_url }}">Shop All</a></li>
        <li><a href="/collections/homem">Men</a></li>
        <li><a href="/collections/mulher">Women</a></li>
      </ul>
    </nav>

    <!-- Center logo (always an image) -->
    <div class="logo">
      <a href="{{ routes.root_url }}">
        <img src="{{ 'cena-logo.png' | asset_url }}" alt="{{ shop.name }}" class="site-logo site-logo-desktop">
      </a>
    </div>

    <!-- Right menu + icons -->
    <div class="header__actions">

      <!-- Right menu (configurable) -->
      <nav class="menu-right">
        {% if section.settings.menu_right != blank %}
          <ul>
            {% for link in linklists[section.settings.menu_right].links %}
              <li>
                <a 
                  href="{{ link.url }}" 
                  {% if link.title contains 'SALE' %} class="highlight" {% endif %}
                >
                  {{ link.title }}
                </a>
              </li>
            {% endfor %}
          </ul>
        {% endif %}
      </nav>

      <!-- Icons -->
      <div class="header__icons">
        {% render 'localization-pill', id: 'desktop' %}

        <div class="header__icon">
          {% render 'search' %}
        </div>

        <a href="/cart" class="header__icon cart-icon">
          {{ 'icon-cart.svg' | inline_asset_content }}
          <span class="cart-count">{{ cart.item_count }}</span>
        </a>
      </div>

    </div>
  </div>

  <!-- Header Mobile -->
  <div class="header-mobile">
    <div class="mobile-left">
      <!-- Menu button (opens dropdown) -->
      <div class="mobile-menu">
        <button class="mobile-menu-toggle">
          <span class="hamburger-box">
            <span class="hamburger-inner"></span>
          </span>
        </button>
      </div>

      <!-- Search -->
      <div class="header__icon">
        {% render 'search' %}
      </div>
    </div>

    <!-- Center logo -->
    <div class="mobile-logo">
      <a href="{{ routes.root_url }}">
        <img src="{{ 'cena-logo.png' | asset_url }}" alt="{{ shop.name }}" class="site-logo site-logo-mobile">
      </a>
    </div>

    <div class="mobile-right">
      <!-- Cart -->
      <a href="/cart" class="header__icon cart-icon">
        {{ 'icon-cart.svg' | inline_asset_content }}
        <span class="cart-count">{{ cart.item_count }}</span>
      </a>
    </div>
  </div>


</header>

<!-- Mobile nav dropdown (opens from the header) -->
<div class="mobile-nav-dropdown">
  <ul>
    <li><a href="{{ routes.all_products_collection_url }}">Shop All</a></li>
    <li><a href="/collections/homem">Men</a></li>
    <li><a href="/collections/mulher">Women</a></li>
  </ul>
</div>

<style>
/* General */
#header-group {
  position: fixed;
  top: 12px;
  left: 12px;
  right: 12px;
  z-index: var(--layer-overlay, 16);
}

#MainContent {
  padding-top: calc(var(--cena-header-total-height, 96px) + 28px);
}

#MainContent[data-template="index"] > *:first-child {
  margin-top: calc(-1 * (var(--cena-header-total-height, 96px) + 28px));
}

.scuffers-header {
  --header-fg: #000;
  width: 100%;
  padding: 10px 20px;
  font-family: var(--font-body--family, sans-serif);
  position: relative;
  background: rgba(255, 255, 255, 0.45);
  backdrop-filter: blur(16px) saturate(160%);
  -webkit-backdrop-filter: blur(16px) saturate(160%);
  border-radius: 0 0 20px 20px;
  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.12);
  color: var(--header-fg);
  transition: background-color 0.25s ease, color 0.25s ease;
}
.scuffers-header.is-on-dark {
  --header-fg: #fff;
  background: rgba(0, 0, 0, 0.4);
}
.scuffers-header a,
.scuffers-header button {
  -webkit-tap-highlight-color: transparent;
}
.scuffers-header a:focus-visible,
.scuffers-header button:focus-visible {
  outline: 2px solid currentColor;
  outline-offset: 2px;
}
.site-logo {
  width: auto;
  filter: brightness(0);
  transition: filter 0.25s ease;
}
.scuffers-header.is-on-dark .site-logo {
  filter: brightness(0) invert(1);
}
.site-logo-desktop { max-height: 32px; }
.site-logo-mobile { max-height: 30px; }

@media (max-width: 768px) {
  .site-logo-desktop { display: none; }
}
@media (min-width: 769px) {
  .site-logo-mobile { display: none; }
}

/* Desktop Header */
.header-wrapper {
  display: flex;
  align-items: center;
  justify-content: space-between;
  position: relative;
}
.menu-left, .menu-right { flex: 1; }
.menu-left ul, .menu-right ul {
  display: flex;
  gap: 18px;
  list-style: none;
  margin: 0;
  padding: 0;
}
.menu-left a, .menu-right a {
  font-family: var(--font-body--family, sans-serif);
  font-weight: bold;
  text-transform: uppercase;
  text-decoration: none;
  font-size: 14px;
  color: inherit;
  letter-spacing: 0.5px;
  transition: opacity 0.2s ease;
}
.menu-left a:hover, .menu-right a:hover { opacity: 0.6; }
.menu-right .highlight {
  background: yellow;
  padding: 2px 6px;
  font-weight: bold;
}

/* Exact center logo */
.logo {
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  text-align: center;
}

.header__actions {
  display: flex;
  align-items: center;
  gap: 24px;
  margin-left: auto;
}

/* Icons */
.header__icons, .mobile-right {
  display: flex;
  align-items: center;
  gap: 16px;
}
.header__icon {
  display: flex;
  align-items: center;
  justify-content: center;
  text-decoration: none;
  color: inherit;
}
.header__icon svg {
  width: 24px;
  height: 24px;
  display: block;
}
.header__icon .search-action {
  display: flex;
}
.header__icon .search-modal__button {
  background: none;
  border: none;
  padding: 0;
  margin: 0;
  color: inherit;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* Country/Currency selector */
.localization-icon {
  position: relative;
}
.localization-toggle {
  display: flex;
  align-items: center;
  gap: 6px;
  background: rgba(255, 255, 255, 0.6);
  border: 1px solid rgba(0, 0, 0, 0.08);
  border-radius: 999px;
  padding: 5px 10px;
  font-size: 12px;
  font-weight: bold;
  letter-spacing: 0.5px;
  line-height: 1;
  color: inherit;
  cursor: pointer;
}
.scuffers-header.is-on-dark .localization-toggle {
  background: rgba(255, 255, 255, 0.15);
  border-color: rgba(255, 255, 255, 0.25);
}
.localization-flag {
  width: 16px;
  height: 16px;
  border-radius: 50%;
  background-size: cover;
  background-position: center;
  flex-shrink: 0;
}
.localization-currency {
  text-transform: uppercase;
}
.localization-caret {
  display: flex;
  align-items: center;
  width: 10px;
  height: 10px;
}
.localization-caret svg {
  width: 100%;
  height: 100%;
}
.localization-dropdown {
  display: none;
  flex-direction: column;
  position: fixed;
  width: min(280px, calc(100vw - 24px));
  max-height: min(360px, calc(100vh - 24px));
  border-radius: 16px;
  overflow: hidden;
  z-index: var(--layer-overlay, 16);
  background: rgba(255, 255, 255, 0.75);
  backdrop-filter: blur(20px) saturate(160%);
  -webkit-backdrop-filter: blur(20px) saturate(160%);
  border: 1px solid rgba(0, 0, 0, 0.08);
  box-shadow: 0 12px 30px rgba(0, 0, 0, 0.15);
  color: #000;
}
.localization-dropdown.is-on-dark {
  background: rgba(0, 0, 0, 0.55);
  border-color: rgba(255, 255, 255, 0.15);
  color: #fff;
}
.localization-dropdown.active {
  display: flex;
}
.localization-search {
  flex-shrink: 0;
  padding: 10px 14px;
  border-bottom: 1px solid rgba(0, 0, 0, 0.08);
}
.localization-dropdown.is-on-dark .localization-search {
  border-color: rgba(255, 255, 255, 0.15);
}
.localization-search-input {
  -webkit-appearance: none;
  appearance: none;
  box-sizing: border-box;
  display: block;
  width: 100%;
  border: none;
  border-radius: 8px;
  background: rgba(0, 0, 0, 0.06);
  padding: 8px 10px;
  font-size: 13px;
  outline: none;
  color: inherit;
  font-family: inherit;
  -webkit-tap-highlight-color: transparent;
}
.localization-dropdown.is-on-dark .localization-search-input {
  background: rgba(255, 255, 255, 0.1);
}
.localization-search-input::placeholder {
  color: currentColor;
  opacity: 0.5;
}
.localization-list {
  list-style: none;
  margin: 0;
  padding: 6px;
  overflow-y: auto;
  scrollbar-width: thin;
  scrollbar-color: rgba(0, 0, 0, 0.25) transparent;
}
.localization-dropdown.is-on-dark .localization-list {
  scrollbar-color: rgba(255, 255, 255, 0.3) transparent;
}
.localization-list::-webkit-scrollbar {
  width: 6px;
}
.localization-list::-webkit-scrollbar-track {
  background: transparent;
}
.localization-list::-webkit-scrollbar-thumb {
  background: rgba(0, 0, 0, 0.25);
  border-radius: 999px;
}
.localization-dropdown.is-on-dark .localization-list::-webkit-scrollbar-thumb {
  background: rgba(255, 255, 255, 0.3);
}
.localization-list__item.is-hidden {
  display: none;
}
.localization-list__button {
  width: 100%;
  display: flex;
  align-items: center;
  gap: 10px;
  background: none;
  border: none;
  padding: 8px 10px;
  border-radius: 10px;
  cursor: pointer;
  font-size: 13px;
  color: inherit;
  text-align: left;
  font-family: inherit;
}
.localization-list__button:hover {
  background: rgba(0, 0, 0, 0.06);
}
.localization-dropdown.is-on-dark .localization-list__button:hover {
  background: rgba(255, 255, 255, 0.12);
}
.localization-list__item.is-active .localization-list__button {
  background: rgba(0, 0, 0, 0.08);
  font-weight: bold;
}
.localization-dropdown.is-on-dark .localization-list__item.is-active .localization-list__button {
  background: rgba(255, 255, 255, 0.18);
}
.localization-list__flag {
  width: 18px;
  height: 18px;
  border-radius: 50%;
  background-size: cover;
  background-position: center;
  flex-shrink: 0;
}
.localization-list__name {
  flex: 1;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.localization-list__currency {
  opacity: 0.6;
  font-size: 11px;
  text-transform: uppercase;
  flex-shrink: 0;
}
.localization-empty {
  margin: 0;
  padding: 16px;
  font-size: 12px;
  text-align: center;
  opacity: 0.6;
}

/* Footer instance: matches the footer's white background instead of the header's glass */
.localization-dropdown[data-instance="footer"] {
  background: #fff;
  border: 1px solid #eee;
  color: #000;
}

/* Cart badge */
.cart-icon { position: relative; }
.cart-count {
  position: absolute;
  top: -6px;
  right: -10px;
  background: black;
  color: white;
  font-size: 11px;
  font-weight: bold;
  border-radius: 50%;
  padding: 2px 6px;
  line-height: 1;
  min-width: 18px;
  text-align: center;
}

/* Mobile Header */
.header-mobile {
  display: none;
  align-items: center;
  justify-content: space-between;
  padding: 14px 18px;
  position: relative;
}
.header-mobile .mobile-left,
.header-mobile .mobile-right {
  display: flex;
  align-items: center;
  gap: 18px;
}
.mobile-logo {
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
}

/* Boxed hamburger style */
.mobile-menu-toggle {
  background: transparent;
  border: 1px solid currentColor;
  padding: 6px;
  border-radius: 2px;
  cursor: pointer;
  outline: none;
  -webkit-tap-highlight-color: transparent;
}
.mobile-menu-toggle:focus-visible {
  outline: 2px solid currentColor;
  outline-offset: 2px;
}
.hamburger-box {
  width: 20px;
  height: 16px;
  display: inline-block;
  position: relative;
}
.hamburger-inner,
.hamburger-inner::before,
.hamburger-inner::after {
  width: 20px;
  height: 2px;
  background-color: currentColor;
  position: absolute;
  transition: all 0.3s ease;
  content: "";
  left: 0;
}
.hamburger-inner { top: 50%; transform: translateY(-50%); }
.hamburger-inner::before { top: -6px; }
.hamburger-inner::after { top: 6px; }

/* Mobile nav dropdown — opens from the header, same glass style */
.mobile-nav-dropdown {
  --header-fg: #000;
  display: none;
  position: fixed;
  top: calc(12px + var(--cena-header-total-height, 96px) + 8px);
  left: 12px;
  right: 12px;
  background: rgba(255, 255, 255, 0.7);
  backdrop-filter: blur(16px) saturate(160%);
  -webkit-backdrop-filter: blur(16px) saturate(160%);
  border-radius: 20px;
  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.12);
  padding: 20px;
  z-index: var(--layer-overlay, 16);
  opacity: 0;
  visibility: hidden;
  transform: translateY(-8px);
  color: var(--header-fg);
  transition: opacity 0.2s ease, transform 0.2s ease, background-color 0.25s ease, color 0.25s ease, visibility 0.2s ease;
  pointer-events: none;
}
.mobile-nav-dropdown.is-on-dark {
  --header-fg: #fff;
  background: rgba(0, 0, 0, 0.55);
}
.mobile-nav-dropdown.active {
  display: block;
  opacity: 1;
  visibility: visible;
  transform: translateY(0);
  pointer-events: auto;
}
.mobile-nav-dropdown ul {
  list-style: none;
  padding: 0;
  margin: 0;
}
.mobile-nav-dropdown li { margin-bottom: 16px; }
.mobile-nav-dropdown li:last-child { margin-bottom: 0; }
.mobile-nav-dropdown a {
  font-family: var(--font-body--family, sans-serif);
  font-weight: bold;
  text-transform: uppercase;
  text-decoration: none;
  font-size: 16px;
  color: inherit;
  letter-spacing: 0.5px;
  -webkit-tap-highlight-color: transparent;
}

@media (min-width: 769px) {
  .mobile-nav-dropdown { display: none !important; }
}

/* Responsiveness */
@media (min-width: 769px) {
  .header-wrapper { display: flex; }
  .header-mobile { display: none; }
}
@media (max-width: 768px) {
  .header-wrapper { display: none; }
  .header-mobile { display: flex; }
}

/* Search bar — anchored right below the floating header instead of a centered modal */
dialog-component#search-modal .search-modal__content {
  position: fixed !important;
  top: calc(12px + var(--cena-header-total-height, 96px) + 8px) !important;
  left: 12px !important;
  right: 12px !important;
  bottom: auto !important;
  width: auto !important;
  max-width: none !important;
  max-height: 70vh !important;
  margin: 0 !important;
  border-radius: 20px !important;
  background: rgba(255, 255, 255, 0.92) !important;
  backdrop-filter: blur(16px) saturate(160%) !important;
  -webkit-backdrop-filter: blur(16px) saturate(160%) !important;
}
dialog-component#search-modal .search-modal__content::backdrop {
  background: transparent !important;
}
dialog-component#search-modal predictive-search-component {
  font-family: var(--font-body--family, sans-serif) !important;
  background: transparent !important;
}
dialog-component#search-modal .predictive-search-form__header {
  background: transparent !important;
  border: none !important;
  border-bottom: 1px solid rgba(0, 0, 0, 0.15) !important;
  border-radius: 0 !important;
  padding: 16px 20px !important;
}
dialog-component#search-modal .predictive-search-form__header-inner {
  background: transparent !important;
  border: none !important;
  border-radius: 0 !important;
}
dialog-component#search-modal .predictive-search-form__header-inner:focus-within {
  outline: none !important;
}
dialog-component#search-modal .search-input {
  font-family: var(--font-body--family, sans-serif) !important;
  font-size: 15px !important;
  letter-spacing: 0.5px;
}
dialog-component#search-modal .search-input::placeholder {
  color: rgba(0, 0, 0, 0.45);
  text-transform: uppercase;
  letter-spacing: 1px;
  font-size: 13px;
}
dialog-component#search-modal .predictive-search-form__content-wrapper {
  border-radius: 0 0 20px 20px !important;
  background: transparent !important;
  overflow: visible !important;
}
dialog-component#search-modal .predictive-search-results__inner {
  font-family: var(--font-body--family, sans-serif) !important;
}
dialog-component#search-modal .predictive-search-form__footer {
  position: static !important;
  background: transparent !important;
  padding: 0 20px 20px !important;
}
dialog-component#search-modal .predictive-search-form__content {
  padding-block-end: 0 !important;
}
dialog-component#search-modal .predictive-search__reset-button,
dialog-component#search-modal .predictive-search__search-button,
dialog-component#search-modal .predictive-search-results__title {
  text-transform: uppercase !important;
  letter-spacing: 0.5px;
}

/* Site-wide: buttons/labels in caps, except footer links and product-page content */
:is(button, .button):not(.footer-column *) {
  text-transform: uppercase;
}
main[data-template="product"] :is(button, .button) {
  text-transform: none;
}

/* Homepage hero: custom desktop-only photo (mobile keeps the original) */
@media (min-width: 750px) {
  #MainContent[data-template="index"] .hero__image--desktop {
    content: url('{{ "hero-desktop.jpg" | asset_url }}') !important;
  }
}

/* Shopify's default policy pages (Refund, Shipping, Privacy, Terms):
   consistent sizing to match the rest of the site's typography. */
.shopify-policy__container {
  font-family: var(--font-body--family, sans-serif);
  max-width: 800px;
  margin: 0 auto;
  padding: 60px 20px;
}
.shopify-policy__title {
  display: none !important;
}
.shopify-policy__body,
.shopify-policy__body p,
.shopify-policy__body li,
.shopify-policy__body span,
.shopify-policy__body td {
  font-size: var(--font-size--md, 1rem) !important;
  line-height: 1.6;
}
.shopify-policy__body h1,
.shopify-policy__body h2,
.shopify-policy__body h3,
.shopify-policy__body h4,
.shopify-policy__body h5,
.shopify-policy__body h6 {
  font-size: var(--font-size--lg, 1.125rem) !important;
  font-weight: bold;
  text-transform: uppercase;
  margin-top: 24px;
}
</style>

<script>
document.addEventListener("DOMContentLoaded", function() {
  const toggle = document.querySelector(".mobile-menu-toggle");
  const dropdown = document.querySelector(".mobile-nav-dropdown");

  if (toggle && dropdown) {
    const links = dropdown.querySelectorAll("a");

    toggle.addEventListener("click", (event) => {
      event.stopPropagation();
      dropdown.classList.toggle("active");
    });

    links.forEach(link => {
      link.addEventListener("click", () => {
        dropdown.classList.remove("active");
      });
    });

    document.addEventListener("click", (event) => {
      if (!dropdown.contains(event.target) && event.target !== toggle && !toggle.contains(event.target)) {
        dropdown.classList.remove("active");
      }
    });
  }

  function positionLocalizationDropdown(toggle, dropdown) {
    const margin = 12;
    const toggleRect = toggle.getBoundingClientRect();
    const dropdownWidth = dropdown.offsetWidth;
    const dropdownHeight = dropdown.offsetHeight;

    let left = toggleRect.right - dropdownWidth;
    left = Math.max(margin, Math.min(left, window.innerWidth - dropdownWidth - margin));

    const spaceBelow = window.innerHeight - toggleRect.bottom;
    let top;
    if (spaceBelow < dropdownHeight + margin && toggleRect.top > dropdownHeight + margin) {
      top = toggleRect.top - dropdownHeight - 8;
    } else {
      top = toggleRect.bottom + 8;
    }
    top = Math.max(margin, Math.min(top, window.innerHeight - dropdownHeight - margin));

    dropdown.style.left = left + "px";
    dropdown.style.top = top + "px";
  }

  const localizationInstances = document.querySelectorAll("[data-localization-instance]");

  localizationInstances.forEach((instance) => {
    const localizationToggle = instance.querySelector(".localization-toggle");
    const localizationDropdown = instance.querySelector(".localization-dropdown");

    if (!localizationToggle || !localizationDropdown) return;

    // .scuffers-header (and any similar glass container) has a backdrop-filter,
    // which makes it the containing block for fixed-position descendants.
    // Moving the dropdown to <body> guarantees position: fixed is always
    // relative to the real viewport, regardless of where the toggle lives.
    document.body.appendChild(localizationDropdown);

    localizationToggle.addEventListener("click", (event) => {
      event.stopPropagation();
      const isOpen = localizationDropdown.classList.toggle("active");
      localizationToggle.setAttribute("aria-expanded", isOpen ? "true" : "false");
      if (isOpen) {
        const scuffersHeader = document.querySelector(".scuffers-header");
        localizationDropdown.classList.toggle("is-on-dark", !!(scuffersHeader && scuffersHeader.classList.contains("is-on-dark")));
        positionLocalizationDropdown(localizationToggle, localizationDropdown);
        const searchInput = localizationDropdown.querySelector("[data-localization-search]");
        if (searchInput) {
          searchInput.value = "";
          localizationDropdown.querySelectorAll("[data-localization-list] .localization-list__item").forEach((item) => {
            item.classList.remove("is-hidden");
          });
          const emptyMessage = localizationDropdown.querySelector("[data-localization-empty]");
          if (emptyMessage) emptyMessage.hidden = true;
          window.requestAnimationFrame(() => searchInput.focus());
        }
      }
    });

    window.addEventListener("resize", () => {
      if (localizationDropdown.classList.contains("active")) {
        positionLocalizationDropdown(localizationToggle, localizationDropdown);
      }
    });

    document.addEventListener("click", (event) => {
      if (!instance.contains(event.target) && !localizationDropdown.contains(event.target)) {
        localizationDropdown.classList.remove("active");
        localizationToggle.setAttribute("aria-expanded", "false");
      }
    });

    const searchInput = localizationDropdown.querySelector("[data-localization-search]");
    const listItems = localizationDropdown.querySelectorAll("[data-localization-list] .localization-list__item");
    const emptyMessage = localizationDropdown.querySelector("[data-localization-empty]");

    if (searchInput && listItems.length) {
      searchInput.addEventListener("click", (event) => event.stopPropagation());
      searchInput.addEventListener("input", () => {
        const query = searchInput.value.trim().toLowerCase();
        let visibleCount = 0;

        listItems.forEach((item) => {
          const matches = item.dataset.countryName.indexOf(query) !== -1;
          item.classList.toggle("is-hidden", !matches);
          if (matches) visibleCount += 1;
        });

        if (emptyMessage) emptyMessage.hidden = visibleCount !== 0;
      });
    }
  });

  // Adapts the floating header's colors (logo, text, icons, glass tint)
  // to whatever is currently behind it as the page scrolls.
  const scuffersHeader = document.querySelector(".scuffers-header");
  const mobileNavDropdown = document.querySelector(".mobile-nav-dropdown");

  if (scuffersHeader) {
    function getEffectiveBackgroundIsDark(element) {
      let node = element;
      while (node && node !== document.documentElement) {
        const style = getComputedStyle(node);

        if (style.backgroundImage && style.backgroundImage !== "none") {
          return true;
        }
        if (node.tagName === "IMG" || node.tagName === "VIDEO" || node.tagName === "PICTURE") {
          return true;
        }

        const match = style.backgroundColor.match(/[\d.]+/g);
        if (match && match.length >= 3) {
          const alpha = match.length === 4 ? parseFloat(match[3]) : 1;
          if (alpha > 0.05) {
            const [r, g, b] = match.map(Number);
            const luminance = (0.299 * r + 0.587 * g + 0.114 * b) / 255;
            return luminance < 0.55;
          }
        }

        node = node.parentElement;
      }
      return false;
    }

    function updateHeaderContrast() {
      const rect = scuffersHeader.getBoundingClientRect();
      const probeX = window.innerWidth / 2;
      const probeY = rect.bottom + 4;
      const target = document.elementFromPoint(probeX, probeY);
      if (!target) return;

      const isDark = getEffectiveBackgroundIsDark(target);
      scuffersHeader.classList.toggle("is-on-dark", isDark);
      if (mobileNavDropdown) {
        mobileNavDropdown.classList.toggle("is-on-dark", isDark);
      }
    }

    updateHeaderContrast();
    window.addEventListener("scroll", updateHeaderContrast, { passive: true });
    window.addEventListener("resize", updateHeaderContrast);
  }
});
</script>

