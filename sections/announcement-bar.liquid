<div class="announcement-bar">
  <div class="announcement-text">
    {% assign phrases = section.settings.message | split: " — " %}
    {% for phrase in phrases %}
      <span class="announcement-phrase">{{ phrase }}</span>
    {% endfor %}
    {% for phrase in phrases %}
      <span class="announcement-phrase">{{ phrase }}</span>
    {% endfor %}
  </div>
</div>

<style>
.announcement-bar {
  background-color: {{ section.settings.bg_color }};
  color: {{ section.settings.text_color }};
  overflow: hidden;
  white-space: nowrap;
  padding: 6px 0;
  font-size: 14px;
  font-weight: 500;
  position: relative;
  z-index: 50;
  text-transform: uppercase;
  border-radius: 20px 20px 0 0;
}

.announcement-text {
  display: inline-block;
  animation: scroll-left {{ section.settings.speed }}s linear infinite;
  letter-spacing: 1px;
}

.announcement-phrase {
  display: inline-block; /* keeps each phrase inline */
  margin-right: {{ section.settings.phrase_spacing }}px; /* spacing between phrases */
}
  
@keyframes scroll-left {
  0% {
    transform: translateX(0);
  }
  100% {
    transform: translateX(-50%); /* 50% because we duplicated the content */
  }
}
</style>

{% schema %}
{
  "name": "Animated announcement bar",
  "settings": [
    {
      "type": "text",
      "id": "message",
      "label": "Message",
      "default": "FEEDING THE STREETS ® — STAY OUT OF TROUBLE — SHIPPED IN 24HRS"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#064e3b"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "speed",
      "label": "Animation speed (seconds)",
      "min": 5,
      "max": 30,
      "step": 1,
      "default": 15
    },
    {
      "type": "range",
      "id": "phrase_spacing",
      "label": "Spacing between phrases (px)",
      "min": 0,
      "max": 200,
      "step": 2,
      "default": 50
    }
  ],
  "presets": [
    {
      "name": "Animated announcement bar"
    }
  ]
}
{% endschema %}
